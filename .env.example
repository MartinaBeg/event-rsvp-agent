# Apify
APIFY_TOKEN=                  # Apify API token (get one at https://console.apify.com/account/integrations)
APIFY_ACTOR_ID=2SyF0bVxmgGr8IVCZ
APIFY_BATCH_SIZE=25

# Local Excel workbook
EXCEL_PATH=./rsvp.xlsx        # path to the .xlsx the agent will read & write
EXCEL_TAB=RSVP List           # worksheet/tab name inside the workbook

# Pipeline
APPROVAL_CAP=75
DRY_RUN=false                 # if true, log decisions but don't write the workbook

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console            # `console` or `json`
